MOODLE_URL=https://moodle.example.edu
HUB_PUBLIC_URL=https://notebooks.example.net
HOST_WORKSPACE_ROOT=/srv/notebooks
WORKSPACE_SLOTS=128
PYTHON_IMAGE=moodle-notebook-python:0.1.0
# Keep old validated image IDs installed and allowed on BOTH VMs for earlier assignments.
PYTHON_IMAGES=
PROXY_IMAGE=moodle-notebook-proxy:0.1.0
# Optional, exact public API hostnames approved by the administrator, separated by commas.
API_ALLOWLIST=
CELL_TIMEOUT=60
COPY_TIMEOUT=300
# Generate each independently: openssl rand -hex 32. Never commit .env.
WORKSPACE_TOKEN=
GRADER_TOKEN=
MOODLE_TOKEN=
HUB_TOKEN=
JUPYTERHUB_CRYPT_KEY=
