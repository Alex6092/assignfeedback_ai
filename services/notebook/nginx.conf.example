# Install on the workspace host; replace names and certificate paths.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
    listen 443 ssl;
    server_name notebooks.example.net *.notebooks.example.net;
    ssl_certificate /etc/ssl/notebooks/fullchain.pem;
    ssl_certificate_key /etc/ssl/notebooks/privkey.pem;
    client_max_body_size 60m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 3600;
    }
}
# Separate private hostname, reachable ONLY by Moodle and administrators.
server {
    listen 443 ssl;
    server_name notebook-api.internal.example.net;
    ssl_certificate /etc/ssl/notebook-api/fullchain.pem;
    ssl_certificate_key /etc/ssl/notebook-api/privkey.pem;
    client_max_body_size 60m;
    location / { proxy_pass http://127.0.0.1:8082; }
}
# On the grader VM use an equivalent private TLS virtual host proxying port 8083.
