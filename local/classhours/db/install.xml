<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/classhours/db" VERSION="20260926" COMMENT="Heures de cours : emploi du temps par cours, ouvertures exceptionnelles, périodes fermées, option EFE"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_classhours_slot" COMMENT="Créneau hebdomadaire d'un cours (heures du fuseau du serveur)">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"     TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="groupid"      TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="0 = tout le cours"/>
        <FIELD NAME="weekday"      TYPE="int" LENGTH="1"  NOTNULL="true" SEQUENCE="false" COMMENT="1 = lundi ... 7 = dimanche (ISO-8601)"/>
        <FIELD NAME="starttime"    TYPE="int" LENGTH="4"  NOTNULL="true" SEQUENCE="false" COMMENT="Minutes depuis minuit"/>
        <FIELD NAME="endtime"      TYPE="int" LENGTH="4"  NOTNULL="true" SEQUENCE="false" COMMENT="Minutes depuis minuit (après starttime)"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="groupid"  UNIQUE="false" FIELDS="groupid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_classhours_period" COMMENT="Ouverture exceptionnelle (open) ou période fermée (closed) d'un cours ; courseid = 0 : période fermée globale du site">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="courseid"     TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false" COMMENT="0 = période globale (vacances), réglée par l'administrateur"/>
        <FIELD NAME="groupid"      TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false" DEFAULT="0" COMMENT="0 = tout le cours"/>
        <FIELD NAME="type"         TYPE="char" LENGTH="10"  NOTNULL="true"  SEQUENCE="false" COMMENT="open|closed"/>
        <FIELD NAME="timestart"    TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
        <FIELD NAME="timeend"      TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false" COMMENT="Exclu. Période fermée : minuit du lendemain du dernier jour"/>
        <FIELD NAME="name"         TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Libellé (rattrapage, vacances de la Toussaint...)"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_type" UNIQUE="false" FIELDS="courseid, type"/>
        <INDEX NAME="groupid"     UNIQUE="false" FIELDS="groupid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_classhours_course" COMMENT="Réglages Heures de cours d'un cours (sans ligne : valeurs par défaut du site)">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"     TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="efeauto"      TYPE="int" LENGTH="1"  NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="1 = restreindre automatiquement les activités à remontée EFE"/>
        <FIELD NAME="useglobal"    TYPE="int" LENGTH="1"  NOTNULL="true" SEQUENCE="false" DEFAULT="1" COMMENT="1 = appliquer les périodes fermées globales du site"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid" UNIQUE="true" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_classhours_exclude" COMMENT="Activité exclue de la restriction automatique EFE">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid"        TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid"    TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid"     UNIQUE="true"  FIELDS="cmid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_classhours_grant" COMMENT="Accès ponctuel d'un élève à une activité fermée : demande de l'élève, décision de l'enseignant, fenêtre accordée">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false"/>
        <FIELD NAME="cmid"            TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false"/>
        <FIELD NAME="userid"          TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false" COMMENT="L'élève"/>
        <FIELD NAME="status"          TYPE="char" LENGTH="10" NOTNULL="true"  SEQUENCE="false" COMMENT="pending|accepted|refused|cancelled"/>
        <FIELD NAME="reason"          TYPE="text"             NOTNULL="false" SEQUENCE="false" COMMENT="Message facultatif de l'élève"/>
        <FIELD NAME="requestedat"     TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="decidedby"       TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false" DEFAULT="0" COMMENT="Enseignant qui a décidé (0 : en attente)"/>
        <FIELD NAME="decidedat"       TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="decisioncomment" TYPE="text"             NOTNULL="false" SEQUENCE="false" COMMENT="Commentaire facultatif de l'enseignant"/>
        <FIELD NAME="timestart"       TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false" DEFAULT="0" COMMENT="Début de la fenêtre accordée"/>
        <FIELD NAME="timeend"         TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false" DEFAULT="0" COMMENT="Fin de la fenêtre accordée (exclue)"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cm_user_status"  UNIQUE="false" FIELDS="cmid, userid, status"/>
        <INDEX NAME="course_status"   UNIQUE="false" FIELDS="courseid, status"/>
        <INDEX NAME="course_user"     UNIQUE="false" FIELDS="courseid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
