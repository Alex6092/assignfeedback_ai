<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aifeedback/db" VERSION="20261030" COMMENT="Shared AI feedback infrastructure">
  <TABLES>

    <TABLE NAME="local_aifeedback_qgrading" COMMENT="One row per quiz question_attempt graded (or being graded) by the LLM, shared by all AI question types">
      <FIELDS>
        <FIELD NAME="id"                TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="component"         TYPE="char"   LENGTH="100" NOTNULL="true" DEFAULT="" COMMENT="Frankenstyle of the owning qtype, e.g. qtype_aiessay"/>
        <FIELD NAME="questionattemptid" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="questionid"        TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid"            TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status"            TYPE="char"   LENGTH="20"  NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="attempts"          TYPE="int"    LENGTH="4"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="aifeedback"        TYPE="text"                NOTNULL="false"/>
        <FIELD NAME="error_message"     TYPE="text"                NOTNULL="false"/>
        <FIELD NAME="mark"              TYPE="number" LENGTH="10"  DECIMALS="5" NOTNULL="false"/>
        <FIELD NAME="timecreated"       TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"      TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"         TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionattempt" TYPE="unique"  FIELDS="questionattemptid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="component_status" UNIQUE="false" FIELDS="component, status"/>
        <INDEX NAME="comp_question_user" UNIQUE="false" FIELDS="component, questionid, userid"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_aifeedback_job" COMMENT="Generations submitted to the inference load balancer (asynchronous jobs with callback)">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="component"        TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="" COMMENT="Frankenstyle of the handler, e.g. assignfeedback_ai"/>
        <FIELD NAME="payload"          TYPE="text"              NOTNULL="false" COMMENT="Handler payload (JSON)"/>
        <FIELD NAME="payloadkey"       TYPE="char" LENGTH="40"  NOTNULL="true" DEFAULT="" COMMENT="sha1(component|payload), deduplication"/>
        <FIELD NAME="userid"           TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="User the generation is made for (0 = system)"/>
        <FIELD NAME="model"            TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="lbjobid"          TYPE="char" LENGTH="64"  NOTNULL="true" DEFAULT="" COMMENT="Job id on the load balancer"/>
        <FIELD NAME="lbstatus"         TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="" COMMENT="Final status on the load balancer: succeeded|failed|cancelled|expired"/>
        <FIELD NAME="eventid"          TYPE="char" LENGTH="64"  NOTNULL="true" DEFAULT="" COMMENT="Callback event id (X-Event-ID)"/>
        <FIELD NAME="status"           TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="submitting" COMMENT="submitting|submitted|received|processing|done|failed|cancelled"/>
        <FIELD NAME="attempt"          TYPE="int"  LENGTH="4"   NOTNULL="true" DEFAULT="1" COMMENT="Submission number of this row (idempotency key)"/>
        <FIELD NAME="expectjson"       TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="result"           TYPE="text"              NOTNULL="false" COMMENT="Raw model response, kept only until applied"/>
        <FIELD NAME="error"            TYPE="text"              NOTNULL="false"/>
        <FIELD NAME="prompttokens"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completiontokens" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"      TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timesubmitted"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecompleted"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="lbjobid"            UNIQUE="false" FIELDS="lbjobid"/>
        <INDEX NAME="comp_key_status"    UNIQUE="false" FIELDS="component, payloadkey, status"/>
        <INDEX NAME="status_submitted"   UNIQUE="false" FIELDS="status, timesubmitted"/>
        <INDEX NAME="userid"             UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
