<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aifeedback/db" VERSION="20260918" COMMENT="Shared AI feedback infrastructure">
  <TABLES>

    <TABLE NAME="local_aifeedback_qgrading" COMMENT="One row per quiz question_attempt graded (or being graded) by the LLM, shared by all AI question types">
      <FIELDS>
        <FIELD NAME="id"                TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="component"         TYPE="char"   LENGTH="100" NOTNULL="true" DEFAULT="" COMMENT="Frankenstyle of the owning qtype, e.g. qtype_aiessay"/>
        <FIELD NAME="questionattemptid" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="questionid"        TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid"            TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status"            TYPE="char"   LENGTH="20"  NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="attempts"          TYPE="int"    LENGTH="4"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="aifeedback"        TYPE="text"                NOTNULL="false"/>
        <FIELD NAME="error_message"     TYPE="text"                NOTNULL="false"/>
        <FIELD NAME="mark"              TYPE="number" LENGTH="10"  DECIMALS="5" NOTNULL="false"/>
        <FIELD NAME="timecreated"       TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"      TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"         TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionattempt" TYPE="unique"  FIELDS="questionattemptid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="component_status" UNIQUE="false" FIELDS="component, status"/>
        <INDEX NAME="comp_question_user" UNIQUE="false" FIELDS="component, questionid, userid"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_aifeedback_slot" COMMENT="Tickets of the shared LLM server pool: one row per regulated LLM request (queue place)">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="purpose"       TYPE="char" LENGTH="16"  NOTNULL="true" DEFAULT="tutor" COMMENT="tutor|feedback. Tutor requests are interactive and admitted first."/>
        <FIELD NAME="serverid"      TYPE="int"  LENGTH="2"   NOTNULL="true" DEFAULT="0" COMMENT="Configured server slot 1..3, 0 while still queued"/>
        <FIELD NAME="status"        TYPE="char" LENGTH="16"  NOTNULL="true" DEFAULT="queued" COMMENT="queued|reserved|running|done|failed|cancelled"/>
        <FIELD NAME="userid"        TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="0 for system/cron requests"/>
        <FIELD NAME="component"     TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="reference"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Caller-defined id, e.g. local_aichat message id"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timereserved"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timestarted"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeheartbeat" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timefinished"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status_purpose" UNIQUE="false" FIELDS="status, purpose"/>
        <INDEX NAME="status_server"  UNIQUE="false" FIELDS="status, serverid"/>
        <INDEX NAME="userid"         UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="timefinished"   UNIQUE="false" FIELDS="timefinished"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_aifeedback_server" COMMENT="Health and usage state of each configured LLM server slot">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="serverid"     TYPE="int" LENGTH="2"  NOTNULL="true" DEFAULT="0" COMMENT="Configured server slot 1..3"/>
        <FIELD NAME="failinguntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Quarantine deadline after a network failure"/>
        <FIELD NAME="failures"     TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lastused"     TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="serverid" TYPE="unique"  FIELDS="serverid"/>
      </KEYS>
    </TABLE>

  </TABLES>
</XMLDB>
